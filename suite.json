{
  "schema": 1,
  "about": "The Catalyst suite: every app Catalyst Setup installs, where each comes from, and how to tell it is installed. This file is the single source of truth: the Rust side embeds it, the frontend is handed it, and scripts/make-bundle.mjs reads it.",
  "uninstallRoot": "Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall",
  "setup": {
    "about": "Catalyst Setup itself: where its own releases are, where its installed copy lives, and what keeps the apps up to date.",
    "repo": "TomAs-1226/CatalystSetup",
    "tagPrefix": "v",
    "asset": "catalyst-setup.exe",
    "installFolder": "Catalyst Setup",
    "uninstallKey": "Catalyst Setup",
    "task": "Catalyst Setup Auto Update",
    "everyHours": 4,
    "driverStationProcesses": ["DriverStation.exe", "FirstDriverStation.exe"]
  },
  "apps": [
    {
      "id": "catalyst",
      "name": "Catalyst",
      "blurb": "The Catalyst tools in one window, and the library installer for robot projects.",
      "icon": "icons/catalyst.png",
      "default": true,
      "source": { "kind": "github", "repo": "TomAs-1226/CatalystApp", "tagPrefix": "app-v", "assetSuffix": "-setup.exe" },
      "installer": { "kind": "tauri-nsis", "silentArgs": ["/S"] },
      "detect": { "hive": "HKCU", "key": "Catalyst", "exe": "catalyst-app.exe" },
      "bundle": { "from": "github" }
    },
    {
      "id": "console",
      "name": "Catalyst Console",
      "blurb": "The driver station dashboard: read-only telemetry, field and robot views.",
      "icon": "icons/console.png",
      "default": true,
      "source": { "kind": "github", "repo": "TomAs-1226/CatalystConsole", "tagPrefix": "v", "assetSuffix": "-setup.exe" },
      "installer": { "kind": "tauri-nsis", "silentArgs": ["/S"] },
      "detect": { "hive": "HKCU", "key": "Catalyst Console", "exe": "catalyst-console.exe" },
      "bundle": { "from": "github" }
    },
    {
      "id": "sim",
      "name": "Catalyst Sim (MO)",
      "blurb": "Driver practice for Numbers, offline, with the real control map.",
      "icon": "icons/sim.png",
      "default": true,
      "source": { "kind": "payload-only" },
      "installer": { "kind": "catalyst-sim", "silentArgs": ["/silent"], "log": "%TEMP%\\CatalystSimSetup.log" },
      "detect": { "hive": "HKCU", "key": "CatalystSimMO", "exe": "CatalystSim.exe" },
      "bundle": { "from": "file", "path": "../MoSimBuilder/Builds/CatalystSimSetup.exe" }
    },
    {
      "id": "pit",
      "name": "Catalyst Pit",
      "blurb": "Match day in the pit: the pre-match checklist, batteries, the queue and the match log.",
      "icon": "icons/pit.png",
      "iconFrom": "../CatalystPit/src-tauri/icons/128x128.png",
      "default": true,
      "source": { "kind": "github", "repo": "TomAs-1226/CatalystPit", "tagPrefix": "v", "assetSuffix": "-setup.exe" },
      "installer": { "kind": "tauri-nsis", "silentArgs": ["/S"] },
      "detect": { "hive": "HKCU", "key": "Catalyst Pit", "exe": "catalyst-pit.exe" },
      "bundle": { "from": "nsis-dir", "path": "../CatalystPit/src-tauri/target/release/bundle/nsis" }
    },
    {
      "id": "link",
      "name": "Catalyst Link",
      "blurb": "The Tab5 companion. Optional: only for laptops that pair with a Catalyst Tab.",
      "icon": "icons/link.png",
      "default": false,
      "source": { "kind": "payload-only" },
      "installer": { "kind": "tauri-nsis", "silentArgs": ["/S"] },
      "detect": { "hive": "HKCU", "key": "Catalyst Link", "exe": "catalyst-link-desktop.exe" },
      "bundle": { "from": "nsis-dir", "path": "../_worktrees/Bezel-tab5-linkgui/tab5/link/desktop/src-tauri/target/release/bundle/nsis" }
    }
  ],
  "laptop": [
    {
      "id": "driver-station",
      "name": "FRC Driver Station",
      "url": "https://www.ni.com/en/support/downloads/drivers/download.frc-game-tools.html",
      "urlLabel": "FRC Game Tools at ni.com"
    },
    {
      "id": "game-tools",
      "name": "NI FRC Game Tools",
      "url": "https://www.ni.com/en/support/downloads/drivers/download.frc-game-tools.html",
      "urlLabel": "FRC Game Tools at ni.com"
    },
    {
      "id": "webview2",
      "name": "WebView2 Runtime",
      "url": "https://developer.microsoft.com/en-us/microsoft-edge/webview2/",
      "urlLabel": "WebView2 at microsoft.com"
    }
  ]
}
